# 复制本文件为 .env 后按需修改。
# .env 已被 .gitignore 排除，请勿把真实值提交到仓库。
# Docker Compose 会自动读取本目录下的 .env。

# 数据目录：SQLite 数据库、浏览器 Profile、二维码截图都会写到这里
DATA_DIR=/data

# Web 服务监听地址与端口
HOST=0.0.0.0
PORT=8787

# 驱动：playwright = 真实浏览器；mock = 演示模式（不访问抖音，用于验证界面与调度）
SPARK_DRIVER=playwright

# 是否无头模式。抖音对无头浏览器风控严格，Docker 中请保持 false（配合容器内 Xvfb）
HEADLESS=false

# 时区，决定定时任务的触发时刻
TZ=Asia/Shanghai

# Flask 会话密钥，请替换为随机字符串
SECRET_KEY=请替换为随机字符串

# TOTP 二次验证密钥（Base32）。留空表示关闭 OTP。
# 生成示例：
#   python -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
SPARK_OTP_SECRET=
SPARK_OTP_SESSION_HOURS=12

# 超时时间（秒）
LOGIN_TIMEOUT=300
OP_TIMEOUT=90
